# ==============================================================================
# Open Claude X - 5-Key Fallback Router Configuration
# Configure up to 5 keys for NVIDIA NIM, OpenRouter, or Gemini.
# If Key 1 hits a 429 rate limit or API error, the router automatically fails over to Key 2, 3, 4, 5!
# ==============================================================================

# Provider selection: 'nvidia', 'openrouter', or 'gemini' (Defaults to auto-detect based on keys)
ACTIVE_PROVIDER=nvidia

# --- NVIDIA NIM API Keys (5-Key Fallback Pool) ---
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Default Model: deepseek-ai/deepseek-r1 (or deepseek-ai/deepseek-v3)
NVIDIA_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_KEY_2=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_KEY_3=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_KEY_4=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_KEY_5=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# --- OpenRouter API Keys (5-Key Fallback Pool) ---
# Endpoint: https://openrouter.ai/api/v1/chat/completions
# Default Model: deepseek/deepseek-chat (DeepSeek version 4.1 Flash)
OPENROUTER_KEY_1=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_2=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_3=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_4=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_5=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini API Keys (Fallback) ---
GEMINI_KEY_1=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_KEY_2=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
